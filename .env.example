# Private OpenAI API key. Copy this file to .env and fill the value locally.
OPENAI_API_KEY=

# Exact origin allowed to invoke the live Worker. Use your GitHub Pages origin in production.
LIVE_ALLOWED_ORIGIN=http://127.0.0.1:4187

# Set to the deployed Worker URL when building the static site.
NUXT_PUBLIC_LIVE_API_URL=
